[Unit]
Description=STK DHCP Server (No DNS)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
ExecStart=/usr/bin/dnsmasq -k --listen-address=192.168.1.2 --bind-interfaces --dhcp-range=192.168.1.50,192.168.1.150,12h --port=0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
