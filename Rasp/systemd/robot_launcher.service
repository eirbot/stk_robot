[Unit]
Description=Eirbot 2026 Button Launcher
After=network.target

[Service]
# Référence : le service réellement installé est généré par init.sh (étape 7)
User=eirbot
WorkingDirectory=/home/eirbot/Documents/robot_stk
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/eirbot/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/eirbot/Documents/robot_stk/.venv/bin/python3 /home/eirbot/Documents/robot_stk/launcher.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
